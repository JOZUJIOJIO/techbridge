{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "qianx-corporate",
  "compatibility_date": "2026-08-05",
  "main": "./src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "qianx.ai",
      "custom_domain": true
    },
    {
      "pattern": "www.qianx.ai/*",
      "zone_name": "qianx.ai"
    }
  ]
}
