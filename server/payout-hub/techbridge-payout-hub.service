[Unit]
Description=Tech Bridge Payout Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/techbridge-payout-hub
EnvironmentFile=/opt/techbridge-payout-hub/.env
ExecStart=/usr/bin/node /opt/techbridge-payout-hub/index.cjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/techbridge-payout-hub

[Install]
WantedBy=multi-user.target
