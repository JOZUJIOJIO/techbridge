{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techbridge",
  "main": "worker.js",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "WECOM_BRIDGE_URL": "https://api.siliconstory.cn",
    "FEISHU_REVENUE_BASE_TOKEN": "JhsubI59Ua91ALsekSEcl2PSnVd",
    "FEISHU_REVENUE_TABLE_ID": "tbljOET9HlSE6RLY",
    "FEISHU_REVENUE_BASE_URL": "https://mwl7eu6k5hr.feishu.cn/wiki/NaZlwbEvwiRWWIkupbIcyja6nFe?from=from_copylink",
    "FEISHU_AUTOMATION_BASE_TOKEN": "JhsubI59Ua91ALsekSEcl2PSnVd",
    "FEISHU_AUTOMATION_RULES_TABLE_ID": "tblGAL6c3fTiMg9K",
    "FEISHU_CUSTOMER_ATTRIBUTION_TABLE_ID": "tblv7n4Q9KxX8IHK",
    "FEISHU_AUTOMATION_LOG_TABLE_ID": "tblvAgHwvu73horT"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
