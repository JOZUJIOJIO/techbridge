{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techbridge",
  "main": "worker.js",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "WECOM_BRIDGE_URL": "https://api.siliconstory.cn",
    "FEISHU_REVENUE_BASE_TOKEN": "CBmDbVmVJaYwaes47cgcfPwknPd",
    "FEISHU_REVENUE_TABLE_ID": "tblOiNE9apjU64dI",
    "FEISHU_REVENUE_BASE_URL": "https://mwl7eu6k5hr.feishu.cn/base/CBmDbVmVJaYwaes47cgcfPwknPd",
    "FEISHU_AUTOMATION_BASE_TOKEN": "CBmDbVmVJaYwaes47cgcfPwknPd",
    "FEISHU_AUTOMATION_RULES_TABLE_ID": "tblNaoc3lq5mPI75",
    "FEISHU_CUSTOMER_ATTRIBUTION_TABLE_ID": "tbl3Msyhv5AMFjI8",
    "FEISHU_AUTOMATION_LOG_TABLE_ID": "tblOsIcCEVTB6aus"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
